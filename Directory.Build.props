<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Satu sumber versi untuk App, Service, dan installer (Plan 5); build rilis menimpa lewat -p:Version. -->
    <Version>1.0.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Target OS: Windows 10 22H2 (19045) dan Windows 11; lihat spec C-01. -->
    <WindowsTargetFramework>net10.0-windows10.0.19041.0</WindowsTargetFramework>
    <!-- Path sumber di PDB/stack trace dinetralkan agar log tidak memuat path mesin build (spec §7). -->
    <PathMap>$(MSBuildThisFileDirectory)=/repo/</PathMap>
  </PropertyGroup>
</Project>
