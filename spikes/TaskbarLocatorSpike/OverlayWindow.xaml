<Window x:Class="TaskbarLocatorSpike.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetworkSpeed spike overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Left="-10000" Top="-10000">
    <Border Padding="6,2">
        <StackPanel x:Name="Lines" Width="92">
            <TextBlock x:Name="UpText" FontFamily="Segoe UI" FontSize="11" Text="↑ 0.0 KB/s" />
            <TextBlock x:Name="DownText" FontFamily="Segoe UI" FontSize="11" Text="↓ 0.0 KB/s" />
        </StackPanel>
    </Border>
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Position: Left" Click="OnPositionLeft" />
            <MenuItem Header="Position: Center" Click="OnPositionCenter" />
            <MenuItem Header="Position: Right" Click="OnPositionRight" />
            <Separator />
            <MenuItem Header="Recalculate now" Click="OnRecalc" />
            <MenuItem Header="Open log folder" Click="OnOpenLog" />
            <Separator />
            <MenuItem Header="Exit" Click="OnExit" />
        </ContextMenu>
    </Window.ContextMenu>
</Window>
