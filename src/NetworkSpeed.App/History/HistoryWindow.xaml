<Window x:Class="NetworkSpeed.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:history="clr-namespace:NetworkSpeed.App.History"
        Title="Network Speed – History"
        Width="640" Height="360" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="■ Download " Foreground="DodgerBlue" />
            <TextBlock Text="■ Upload" Foreground="DarkOrange" Margin="0,0,16,0" />
            <TextBlock x:Name="TotalsText" />
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" />
        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
            <TabItem Header="Live (60 s)" />
            <TabItem Header="24 hours" />
            <TabItem Header="7 days" />
        </TabControl>
    </DockPanel>
</Window>
