<Window x:Class="NetworkSpeed.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Speed – Settings"
        Width="460" Height="640" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,4,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="ResetButton" Content="Reset to defaults" Padding="10,3" Margin="0,0,8,0" Click="OnReset" />
            <Button Content="Close" Padding="16,3" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="General">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Content="_Units" Target="{Binding ElementName=UnitCombo}" />
                        <ComboBox x:Name="UnitCombo" Grid.Column="1" AutomationProperties.Name="Units" SelectionChanged="OnChanged" />
                        <Label Grid.Row="1" Content="_Refresh" Target="{Binding ElementName=RefreshSlider}" />
                        <DockPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock x:Name="RefreshValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="RefreshSlider" Minimum="500" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True" AutomationProperties.Name="Refresh interval in milliseconds" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox x:Name="AutostartCheck" Grid.Row="2" Grid.ColumnSpan="2" Content="Start when I sign in" Checked="OnChanged" Unchecked="OnChanged" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Adapter">
                    <StackPanel>
                        <ComboBox x:Name="AdapterModeCombo" AutomationProperties.Name="Adapter selection" SelectionChanged="OnChanged" />
                        <ComboBox x:Name="AdapterCombo" AutomationProperties.Name="Specific adapter" DisplayMemberPath="Label" SelectionChanged="OnChanged" />
                        <CheckBox x:Name="VpnCheck" Content="Include VPN adapters in All" Checked="OnChanged" Unchecked="OnChanged" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Position">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LeftRadio" Content="Left" GroupName="Pos" Margin="0,0,16,0" Checked="OnChanged" />
                            <RadioButton x:Name="CenterRadio" Content="Center" GroupName="Pos" Margin="0,0,16,0" Checked="OnChanged" />
                            <RadioButton x:Name="RightRadio" Content="Right" GroupName="Pos" Checked="OnChanged" />
                        </StackPanel>
                        <TextBlock x:Name="PositionHint" Style="{StaticResource Hint}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Label Content="Offset _X" Target="{Binding ElementName=OffsetXBox}" />
                            <TextBox x:Name="OffsetXBox" Width="50" AutomationProperties.Name="Horizontal offset in pixels" LostFocus="OnChanged" />
                            <Label Content="_Y" Margin="12,0,0,0" Target="{Binding ElementName=OffsetYBox}" />
                            <TextBox x:Name="OffsetYBox" Width="50" AutomationProperties.Name="Vertical offset in pixels" LostFocus="OnChanged" />
                            <TextBlock Text=" px (−200 to 200)" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Appearance">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Content="_Layout" Target="{Binding ElementName=LayoutCombo}" />
                        <ComboBox x:Name="LayoutCombo" Grid.Column="1" AutomationProperties.Name="Layout" SelectionChanged="OnChanged" />
                        <Label Grid.Row="1" Content="_Font" Target="{Binding ElementName=FontCombo}" />
                        <ComboBox x:Name="FontCombo" Grid.Row="1" Grid.Column="1" IsEditable="False" AutomationProperties.Name="Font" SelectionChanged="OnChanged" />
                        <Label Grid.Row="2" Content="Font _size" Target="{Binding ElementName=FontSizeSlider}" />
                        <DockPanel Grid.Row="2" Grid.Column="1">
                            <TextBlock x:Name="FontSizeValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="16" TickFrequency="0.5" IsSnapToTickEnabled="True" AutomationProperties.Name="Font size in points" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                        </DockPanel>
                        <Label Grid.Row="3" Content="_Upload color" Target="{Binding ElementName=UpColorBox}" />
                        <TextBox x:Name="UpColorBox" Grid.Row="3" Grid.Column="1" AutomationProperties.Name="Upload color, hex, empty for theme" LostFocus="OnChanged" />
                        <Label Grid.Row="4" Content="_Download color" Target="{Binding ElementName=DownColorBox}" />
                        <TextBox x:Name="DownColorBox" Grid.Row="4" Grid.Column="1" AutomationProperties.Name="Download color, hex, empty for theme" LostFocus="OnChanged" />
                        <Label Grid.Row="5" Content="_Theme" Target="{Binding ElementName=ThemeCombo}" />
                        <ComboBox x:Name="ThemeCombo" Grid.Row="5" Grid.Column="1" AutomationProperties.Name="Theme" SelectionChanged="OnChanged" />
                        <Label Grid.Row="6" Content="_Background" Target="{Binding ElementName=OpacitySlider}" />
                        <DockPanel Grid.Row="6" Grid.Column="1">
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="Background opacity" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                        </DockPanel>
                        <Label Grid.Row="7" Content="_Alert above (MB/s)" Target="{Binding ElementName=ThresholdBox}" />
                        <TextBox x:Name="ThresholdBox" Grid.Row="7" Grid.Column="1" AutomationProperties.Name="Alert threshold in megabytes per second, empty for none" LostFocus="OnChanged" />
                        <Label Grid.Row="8" Content="Alert c_olor" Target="{Binding ElementName=AlertColorBox}" />
                        <TextBox x:Name="AlertColorBox" Grid.Row="8" Grid.Column="1" AutomationProperties.Name="Alert color, hex" LostFocus="OnChanged" />
                        <CheckBox x:Name="FullscreenCheck" Grid.Row="9" Grid.ColumnSpan="2" Content="Hide while a full-screen app is active" Checked="OnChanged" Unchecked="OnChanged" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Monitors">
                    <StackPanel>
                        <ComboBox x:Name="MonitorModeCombo" AutomationProperties.Name="Monitor mode" SelectionChanged="OnChanged" />
                        <ComboBox x:Name="MonitorCombo" AutomationProperties.Name="Specific monitor" SelectionChanged="OnChanged" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Latency">
                    <StackPanel>
                        <CheckBox x:Name="PingCheck" Content="Measure latency (ping)" Checked="OnChanged" Unchecked="OnChanged" />
                        <DockPanel>
                            <Label Content="_Host" Target="{Binding ElementName=PingHostBox}" />
                            <TextBox x:Name="PingHostBox" AutomationProperties.Name="Ping host, empty for default gateway" LostFocus="OnChanged" />
                        </DockPanel>
                        <TextBlock Text="Leave empty to ping the default gateway." Style="{StaticResource Hint}" />
                        <DockPanel>
                            <Label Content="_Every" Target="{Binding ElementName=PingIntervalSlider}" />
                            <TextBlock x:Name="PingIntervalValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="PingIntervalSlider" Minimum="1000" Maximum="60000" TickFrequency="1000" IsSnapToTickEnabled="True" AutomationProperties.Name="Ping interval in milliseconds" ValueChanged="OnSliderChanged" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox x:Name="LatencyOverlayCheck" Content="Show latency on the overlay" Checked="OnChanged" Unchecked="OnChanged" />
                        <TextBlock x:Name="LatencyOverlayHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Data limit (quota)">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Content="Dai_ly limit (GB)" Target="{Binding ElementName=QuotaDailyBox}" />
                        <TextBox x:Name="QuotaDailyBox" Grid.Column="1" AutomationProperties.Name="Daily data limit in gigabytes, empty for none" LostFocus="OnChanged" />
                        <Label Grid.Row="1" Content="Mo_nthly limit (GB)" Target="{Binding ElementName=QuotaMonthlyBox}" />
                        <TextBox x:Name="QuotaMonthlyBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Monthly data limit in gigabytes, empty for none" LostFocus="OnChanged" />
                        <Label Grid.Row="2" Content="Month starts on _day" Target="{Binding ElementName=QuotaStartCombo}" />
                        <ComboBox x:Name="QuotaStartCombo" Grid.Row="2" Grid.Column="1" AutomationProperties.Name="Day of month the monthly period starts" SelectionChanged="OnChanged" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                                   Text="Usage is counted for this PC on the adapters selected above. You are notified at 80% and 100%, once per period. Leave empty to turn a limit off." />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Notifications and hotkey">
                    <StackPanel>
                        <CheckBox x:Name="ConnectivityCheck" Content="Notify when the connection drops or returns" Checked="OnChanged" Unchecked="OnChanged" />
                        <DockPanel>
                            <Label Content="Show/Hide _hotkey" Target="{Binding ElementName=HotkeyBox}" />
                            <TextBox x:Name="HotkeyBox" AutomationProperties.Name="Show or hide hotkey, for example Ctrl+Alt+N" LostFocus="OnChanged" />
                        </DockPanel>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Updates">
                    <StackPanel>
                        <CheckBox x:Name="CheckUpdatesCheck" Content="Check for _new versions" Checked="OnChanged" Unchecked="OnChanged" />
                        <TextBlock x:Name="UpdateFolderText" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
